source "https://rubygems.org"
# GitHub Pages builds this site with its own pinned toolchain; this Gemfile
# only exists so `bundle exec jekyll serve` works for local preview.
gem "jekyll", "~> 4.3"
# Listed in _config.yml plugins. On the GitHub Pages allowlist, so production does
# not need it here -- but a local build fails without it, which blocks verification.
gem "jekyll-sitemap", "~> 1.4"
